00688| export const voidPrefixAndSuffix = ({ fullFileStr, startLine, endLine }: { fullFileStr: string, startLine: number, endLine: number }) => {
00689| 
00690| 	const fullFileLines = fullFileStr.split('\n')
00691| 
00692| 	/*
00693| 
00694| 	a
00695| 	a
00696| 	a     <-- final i (prefix = a\na\n)
00697| 	a
00698| 	|b    <-- startLine-1 (middle = b\nc\nd\n)   <-- initial i (moves up)
00699| 	c
00700| 	d|    <-- endLine-1                          <-- initial j (moves down)
00701| 	e
00702| 	e     <-- final j (suffix = e\ne\n)
00703| 	e
00704| 	e
00705| 	*/
00706| 
00707| 	let prefix = ''
00708| 	let i = startLine - 1  // 0-indexed exclusive
00709| 	// we'll include fullFileLines[i...(startLine-1)-1].join('\n') in the prefix.
00710| 	while (i !== 0) {
00711| 		const newLine = fullFileLines[i - 1]
00712| 		if (newLine.length + 1 + prefix.length <= MAX_PREFIX_SUFFIX_CHARS) { // +1 to include the \n
00713| 			prefix = `${newLine}\n${prefix}`
00714| 			i -= 1
00715| 		}
00716| 		else break
00717| 	}
00718| 
00719| 	let suffix = ''
00720| 	let j = endLine - 1
00721| 	while (j !== fullFileLines.length - 1) {
00722| 		const newLine = fullFileLines[j + 1]
00723| 		if (newLine.length + 1 + suffix.length <= MAX_PREFIX_SUFFIX_CHARS) { // +1 to include the \n
00724| 			suffix = `${suffix}\n${newLine}`
00725| 			j += 1
00726| 		}
00727| 		else break
00728| 	}
00729| 
00730| 	return { prefix, suffix }
00731| 
00732| }
